# 이 파일을 복사해서 .env 로 쓰세요.
#
#   cp .env.example .env
#
# 실제 값은 백엔드 팀원에게 받아주세요. .env 는 절대 커밋하지 마세요(.gitignore 등록됨).
# docker compose 와 ./gradlew bootRun 이 같은 .env 를 읽습니다.
#
# 참고: 셸에 이미 같은 이름의 환경변수가 있으면 그쪽이 이깁니다(양쪽 실행 방법 모두 동일).

# ── 공통 (두 실행 방법 모두 필요) ────────────────────────────
DB_PASSWORD=
JWT_SECRET=
GOOGLE_CLIENT_IDS=
OPENAI_API_KEY=

# ── ./gradlew bootRun 으로 직접 실행할 때만 필요 ─────────────
# docker compose 로 띄울 때는 이 두 값을 쓰지 않습니다.
# 컨테이너 안에서는 DB 주소가 localhost 가 아니라 서비스명 db 라서,
# compose.yaml 이 직접 넣어줍니다.
DB_URL=jdbc:postgresql://localhost:5432/twigtree-db
DB_USERNAME=twigtree123

# ── 선택 (application.yml 에 기본값이 있어 비워둬도 됩니다) ──
# 트리 생성 기본 모델은 #40 에서 논의 중이므로 기본값 사용을 권장합니다.
#OPENAI_MODEL=gpt-4o-mini
#REDIS_HOST=localhost
#REDIS_PORT=6379
